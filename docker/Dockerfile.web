# syntax=docker/dockerfile:1.6
# Multi-stage build for the Next.js web app.
#
# Build context: repo root (`docker build -f docker/Dockerfile.web .`)

###################
# Stage 1 — deps  #
###################
FROM node:22-alpine AS deps
WORKDIR /build
RUN apk add --no-cache libc6-compat

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --no-progress

###################
# Stage 2 — build #
###################
FROM node:22-alpine AS build
WORKDIR /build
RUN apk add --no-cache libc6-compat

COPY --from=deps /build/node_modules ./node_modules
COPY package.json yarn.lock tsconfig.json next.config.mjs next-env.d.ts ./
COPY public ./public
COPY src ./src

# Disable telemetry to keep build deterministic
ENV NEXT_TELEMETRY_DISABLED=1
RUN yarn build

#####################
# Stage 3 — runtime #
#####################
FROM node:22-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache libc6-compat tini wget && \
    addgroup -g 1001 -S nodejs && \
    adduser -S -u 1001 -G nodejs web

# Next.js standalone output bundles the runtime + minimal node_modules
COPY --from=build --chown=web:nodejs /build/.next/standalone ./
COPY --from=build --chown=web:nodejs /build/.next/static ./.next/static
COPY --from=build --chown=web:nodejs /build/public ./public

USER web

EXPOSE 3000
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server.js"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- --tries=1 --timeout=3 http://127.0.0.1:3000/ || exit 1
