# Build context exclusions for Docker builds.
node_modules
.next
.git
.github
.gitignore
.vscode
.idea
*.log
coverage
dist
.DS_Store

# apps/api outputs (rebuilt inside the image)
apps/api/node_modules
apps/api/dist
apps/api/data
apps/api/.env

# Local env files (secrets stay outside the image)
.env
.env.local
.env.*.local

# Docs (not needed at runtime)
docs/

# Test files (the image runs production only)
**/__tests__
**/*.test.ts
**/*.test.tsx
