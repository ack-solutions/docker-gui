# Web frontend env (Next.js). The only thing the web app needs is to know
# where to talk to the API in dev. Production-mode this is unused (Caddy
# fronts both apps under the same origin).

# Optional: override where the dev server proxies /api/v1/* to.
# Defaults to http://127.0.0.1:4000 (matches apps/api defaults).
# API_PROXY_TARGET=http://127.0.0.1:4000

# Optional: pin the public API URL into the bundle when running the web
# app against an API on a different host. Leave empty to use same-origin
# (dev rewrite or production Caddy).
# NEXT_PUBLIC_API_URL=
