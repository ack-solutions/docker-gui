# Required
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000

# Required in production; must be at least 32 bytes of entropy
JWT_SECRET=dev-secret-do-not-use-in-production-this-is-not-secure-at-all-12345678

# Required to bootstrap the first admin via POST /api/v1/setup/bootstrap
# Once an admin exists, this route is disabled.
SETUP_SECRET=dev-setup-secret-do-not-use-in-production-1234567890abcdef

# Database (SQLite by default — zero setup).
# Path is resolved relative to prisma/schema.prisma, so `../data/app.db`
# points to apps/api/data/app.db.
DATABASE_URL=file:../data/app.db

# Optional: Docker socket path. macOS/Docker Desktop default:
#   ~/.docker/run/docker.sock
# Linux default: /var/run/docker.sock
# DOCKER_SOCKET=/var/run/docker.sock

# Optional
LOG_LEVEL=info
LOG_PRETTY=true
CORS_ORIGINS=http://localhost:3000

# Token TTLs (in seconds)
ACCESS_TOKEN_TTL=900       # 15 min
REFRESH_TOKEN_TTL=604800   # 7 days
