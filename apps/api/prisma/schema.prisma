// Phase 1 schema. Minimal models — auth + audit. Domain models (Sites,
// Domains, etc.) are added in later phases as features land.

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // owner | admin | operator | viewer
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Site {
  id               String    @id @default(uuid())
  primaryDomain    String    @unique
  aliasDomains     String    @default("[]") // JSON array of additional domains
  upstreamUrl      String // host:port (e.g. "web:80") or full URL
  enableHttps      Boolean   @default(true)
  forceHttps       Boolean   @default(true)
  letsEncryptEmail String?
  enabled          Boolean   @default(true)
  status           String    @default("draft") // draft | applied | error
  lastError        String?
  lastAppliedAt    DateTime?
  notes            String?
  // Optional link to a DNS provider that manages this domain. Set when the
  // site was created via the wizard and the user chose auto-DNS. Used to
  // surface drift warnings and one-click DNS reconcile.
  dnsProviderId    String?
  dnsProvider      DnsProvider? @relation(fields: [dnsProviderId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([dnsProviderId])
  @@map("sites")
}

model DnsProvider {
  id                String    @id @default(uuid())
  // Human label shown in the UI ("Cloudflare — main account")
  name              String    @unique
  // Backend kind. Only "cloudflare" today; future: route53, digitalocean, ...
  kind              String
  // Encrypted credentials blob (base64). Format depends on kind:
  //   cloudflare → JSON { apiToken: string }, then encrypted with CryptoBox.
  // We never expose this over the API; only `verified` + `lastVerifiedAt`.
  credentialsCipher String
  verified          Boolean   @default(false)
  lastVerifiedAt    DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sites             Site[]

  @@map("dns_providers")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String // e.g. "container.start", "auth.login"
  targetType String? // e.g. "container", "user"
  targetId   String?
  payload    String? // JSON string
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
