// Phase 1 schema. Minimal models — auth + audit. Domain models (Sites,
// Domains, etc.) are added in later phases as features land.

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // owner | admin | operator | viewer
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Site {
  id               String    @id @default(uuid())
  primaryDomain    String    @unique
  aliasDomains     String    @default("[]") // JSON array of additional domains
  upstreamUrl      String // host:port (e.g. "web:80") or full URL
  enableHttps      Boolean   @default(true)
  forceHttps       Boolean   @default(true)
  letsEncryptEmail String?
  enabled          Boolean   @default(true)
  status           String    @default("draft") // draft | applied | error
  lastError        String?
  lastAppliedAt    DateTime?
  notes            String?
  // Optional link to a DNS provider that manages this domain. Set when the
  // site was created via the wizard and the user chose auto-DNS. Used to
  // surface drift warnings and one-click DNS reconcile.
  dnsProviderId    String?
  dnsProvider      DnsProvider? @relation(fields: [dnsProviderId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([dnsProviderId])
  @@map("sites")
}

model DnsProvider {
  id                String    @id @default(uuid())
  // Human label shown in the UI ("Cloudflare — main account")
  name              String    @unique
  // Backend kind. Only "cloudflare" today; future: route53, digitalocean, ...
  kind              String
  // Encrypted credentials blob (base64). Format depends on kind:
  //   cloudflare → JSON { apiToken: string }, then encrypted with CryptoBox.
  // We never expose this over the API; only `verified` + `lastVerifiedAt`.
  credentialsCipher String
  verified          Boolean   @default(false)
  lastVerifiedAt    DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sites             Site[]

  @@map("dns_providers")
}

model S3Connection {
  id                String    @id @default(uuid())
  // Human label shown in the UI ("Local MinIO", "Wasabi prod")
  name              String    @unique
  // Endpoint URL — for AWS leave region-default; for MinIO/Wasabi/B2/R2 fill in
  endpoint          String
  region            String    @default("us-east-1")
  // Backend flavor — affects which capabilities (IAM admin, etc.) are exposed.
  // "auto" detects MinIO via /minio/admin/v3/info on first verify.
  flavor            String    @default("auto") // auto | minio | aws | other
  // Path-style addressing — required by MinIO, optional for AWS. Default true
  // because most self-hosted endpoints need it.
  pathStyle         Boolean   @default(true)
  // Access key in plaintext (treated as identifier, not a secret on its own).
  accessKey         String
  // Secret key encrypted with CryptoBox(JWT_SECRET). Never exposed by API.
  secretKeyCipher   String
  verified          Boolean   @default(false)
  lastVerifiedAt    DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("s3_connections")
}

model RegistryConnection {
  id             String    @id @default(uuid())
  // Human label ("Local registry", "GHCR mirror")
  name           String    @unique
  // Base URL of the registry v2 API (e.g. http://docker-gui-registry:5000 or
  // https://registry.example.com). No trailing slash.
  endpoint       String
  // Whether this points at the docker-gui-managed registry feature container.
  // Managed connections get push-host hints + can be auto-reconciled.
  managed        Boolean   @default(false)
  // Optional basic-auth username. Empty when the registry is open (e.g. only
  // reachable on the internal docker network).
  username       String?
  // Basic-auth password encrypted with CryptoBox(JWT_SECRET). Never exposed.
  passwordCipher String?
  // Host:port shown in `docker push` instructions for external clients. For a
  // managed registry this is the public host once Caddy fronts it.
  pushHost       String?
  verified       Boolean   @default(false)
  lastVerifiedAt DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("registry_connections")
}

model DatabaseConnection {
  id             String    @id @default(uuid())
  // Human label ("App Postgres", "Analytics MySQL")
  name           String    @unique
  // Engine: postgres | mysql | mariadb
  engine         String
  // Host the api reaches the DB on. For a discovered container this is the
  // container name on the shared docker network; for external DBs a hostname.
  host           String
  port           Int
  username       String
  // Password encrypted with CryptoBox(JWT_SECRET). Never exposed by the API.
  passwordCipher String?
  // Default database / schema to connect to.
  database       String?
  ssl            Boolean   @default(false)
  // Set when this profile was discovered from a managed container, so the UI
  // can show the link and we can offer to keep them in sync.
  containerId    String?
  verified       Boolean   @default(false)
  lastVerifiedAt DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("database_connections")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String // e.g. "container.start", "auth.login"
  targetType String? // e.g. "container", "user"
  targetId   String?
  payload    String? // JSON string
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
